{
  "name": "Instagram Auto Posting with n8n",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtMinute": 2
            }
          ]
        }
      },
      "id": "7b1ab085-1bb8-45d9-8950-faf2c9239c6f",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [-176, 32]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status"
            }
          ]
        },
        "options": {
          "returnFirstMatch": true
        }
      },
      "id": "1369851f-cb38-4019-b30d-f09b29ad0e1b",
      "name": "Get row(s) in sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [48, 32],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR_GOOGLE_SHEETS_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=photo captions:  {{ $json.outlines }}",
        "options": {
          "systemMessage": "you are social media expert who write engaging and seo optimized instagram captions.\ncreate a short catchy caption for the given photo, make sure it sounds natural and appealing to the audience and add five highly relevent hashtags and some key words\nno need to create options just one caption required."
        }
      },
      "id": "7c6d44ed-ba6b-4cab-b87a-e0f3ba847060",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [272, 32],
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {}
      },
      "id": "031f83b1-5760-4638-b830-1f3c86b56657",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [144, 240],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR_GEMINI_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "httpRequestMethod": "POST",
        "graphApiVersion": "v23.0",
        "node": "YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID",
        "edge": "media",
        "options": {
          "queryParameters": {
            "parameter": [
              {
                "name": "image_url",
                "value": "=https://res.cloudinary.com/YOUR_CLOUDINARY_CLOUD_NAME/image/upload/YOUR_FOLDER_PATH/{{ $('Get row(s) in sheet').item.json.name }}"
              },
              {
                "name": "caption",
                "value": "={{ $json.output }}"
              }
            ]
          }
        }
      },
      "id": "65466217-b0e5-44c3-8e94-0b148e2db9fc",
      "name": "Facebook Graph API",
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [640, 32],
      "credentials": {
        "facebookGraphApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR_FACEBOOK_GRAPH_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "httpRequestMethod": "POST",
        "graphApiVersion": "v23.0",
        "node": "YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID",
        "edge": "media_publish",
        "options": {
          "queryParameters": {
            "parameter": [
              {
                "name": "creation_id",
                "value": "={{ $json.id }}"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [1088, 32],
      "id": "9bdab704-ba30-4477-a549-a5415f5bbf13",
      "name": "Facebook Graph API1",
      "credentials": {
        "facebookGraphApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR_FACEBOOK_GRAPH_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "amount": 60
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [864, 32],
      "id": "96bf3fc0-5e1d-4699-a1be-0133adcc279f",
      "name": "Wait",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('Get row(s) in sheet').item.json.row_number }}",
            "status": "Posted"
          },
          "matchingColumns": ["row_number"],
          "schema": [
            {
              "id": "name",
              "displayName": "name",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": true
            },
            {
              "id": "outlines",
              "displayName": "outlines",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": true
            },
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            },
            {
              "id": "row_number",
              "displayName": "row_number",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true,
              "readOnly": true,
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1312, 32],
      "id": "a864ecbd-20a0-4eaf-868e-a680402fa576",
      "name": "Update row in sheet",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR_GOOGLE_SHEETS_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "content": "## Setup\nReplace every YOUR_ placeholder with your own values and reconnect your credentials (Google Sheets, Gemini, Facebook Graph API).\n\nSheet columns needed: name, outlines, status"
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [288, 288],
      "id": "2a0939d3-f998-462b-8288-820db5706dbd",
